<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.armorer.guard.AGENT_ID</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/armorer-guard</string>
    <string>serve</string>
    <string>--config</string><string>/usr/local/etc/armorer-guard/AGENT_ID.json</string>
    <string>--data-dir</string><string>/usr/local/var/lib/armorer-guard/AGENT_ID</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardErrorPath</key><string>/usr/local/var/log/armorer-guard-AGENT_ID.log</string>
</dict>
</plist>
